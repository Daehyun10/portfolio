# 실제 값은 .env 에 넣습니다. 이 파일은 형식만 보여주는 템플릿입니다.

# PostgreSQL 연결 문자열
# DATABASE_URL 은 커넥션 풀러, DIRECT_URL 은 마이그레이션용 직결입니다.
DATABASE_URL=
DIRECT_URL=

# 충분히 길고 무작위한 값으로 채웁니다.
JWT_SECRET=
JWT_EXPIRES_IN="7d"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

# 이미지 저장소
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# 시드로 만들 관리자 계정
ADMIN_EMAIL=
ADMIN_PASSWORD=
