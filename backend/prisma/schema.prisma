generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // 서버리스에서는 pgbouncer 풀러(6543)로 붙고, 마이그레이션만 직결(5432)을 쓴다.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String   @db.Text
  thumbnail   String?
  period      String?
  role        String?
  teamSize    Int?
  stack       String[] @default([])
  githubUrl   String?
  liveUrl     String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  published   Boolean  @default(true)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  troubles Trouble[]

  @@index([published, order])
}

/// 프로젝트에서 겪은 문제와 해결 과정 (원본 사이트의 "고민한 점 / 해결 방법")
model Trouble {
  id        String  @id @default(cuid())
  projectId String
  title     String
  problem   String  @db.Text
  solution  String  @db.Text
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

/// About 페이지는 문서 한 벌이므로 단일 레코드 + 섹션 목록으로 관리
/// 숙련도. 화면에 보이는 순서(높은 → 낮은)대로 선언한다.
enum SkillLevel {
  EXPERT
  PROFICIENT
  ADVANCED
  BEGINNER
}

model Skill {
  id       String     @id @default(cuid())
  aboutId  String
  name     String
  category String?
  level    SkillLevel
  order    Int        @default(0)

  about About @relation(fields: [aboutId], references: [id], onDelete: Cascade)

  @@index([aboutId, order])
}

model About {
  id        String   @id @default("about")
  headline  String
  intro     String   @db.Text
  email     String?
  githubUrl String?
  updatedAt DateTime @updatedAt

  sections AboutSection[]
  skills   Skill[]
}

model AboutSection {
  id      String @id @default(cuid())
  aboutId String
  title   String
  body    String @db.Text
  order   Int    @default(0)

  about About @relation(fields: [aboutId], references: [id], onDelete: Cascade)

  @@index([aboutId, order])
}

/// 화면에 고정으로 박혀 있던 문구를 키-값으로 보관한다.
/// 값이 없으면 프론트의 기본 문구가 그대로 쓰인다.
model SiteText {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
